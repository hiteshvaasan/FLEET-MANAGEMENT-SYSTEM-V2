<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fleetmanagement.controllers.IncidentController"
            stylesheets="@style.css"
            style="-fx-background-color: #f1f5f9;">
    <!-- LEFT SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" prefWidth="220" style="-fx-background-color: #0f172a;" spacing="2">
            <padding><Insets top="25" right="0" bottom="25" left="0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox.margin><Insets left="15" right="10" bottom="30"/></VBox.margin>
                <StackPane prefWidth="36" prefHeight="36" style="-fx-background-color: #2563eb; -fx-background-radius: 8;">
                    <Label text="🚛" style="-fx-font-size: 18px;"/>
                </StackPane>
                <VBox spacing="0">
                    <Label text="𝙁𝙇𝙀𝙀𝙏" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="𝙈𝘼𝙉𝘼𝙂𝙀𝙈𝙀𝙉𝙏" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 10px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="☰" onAction="#toggleSidebar" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 18px; -fx-cursor: hand; -fx-padding: 0;"/>
            </HBox>

            <Label text="  📊    Dashboard" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToDashboard"/>
            <Label text="  🚛    Vehicles" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToVehicles"/>
            <Label text="  👨‍✈️    Drivers" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToDrivers"/>
            <Label text="  🛣️    Trips" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToTrips"/>
            <Label text="  🔧    Maintenance" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToMaintenance"/>
            <Label text="  🚨    Incidents" textFill="WHITE" prefWidth="220" prefHeight="45" style="-fx-background-color: #2563eb; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToIncidents"/>
            <Label text="  📈    Reports" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToReports"/>
            <Label text="  ⚙️    Settings" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToSettings"/>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="15" style="-fx-background-color: #f1f5f9;">
            <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button fx:id="btnHamburger" text="☰" onAction="#toggleSidebar" prefHeight="35" prefWidth="40"
                        style="-fx-background-color: #e2e8f0; -fx-text-fill: #0f172a; -fx-background-radius: 6; -fx-font-size: 18px; -fx-cursor: hand;"/>
                <Label text="Incident &amp; Emergency Management" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            </HBox>

            <!-- TABLE SECTION -->
            <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Reported Incidents" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🗑️ Delete Selected" onAction="#handleDeleteIncident"
                            style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;"/>
                    <Button text="🔥 Delete All" onAction="#handleDeleteAllIncidents"
                            style="-fx-background-color: #7f1d1d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;"/>
                    <Button text="🔄 Refresh List" onAction="#loadIncidents"
                            style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;"/>
                </HBox>
                <TableView fx:id="incidentTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTrip" text="Trip ID" prefWidth="100"/>
                        <TableColumn fx:id="colDriver" text="Driver ID" prefWidth="100"/>
                        <TableColumn fx:id="colType" text="Incident Type" prefWidth="200"/>
                        <TableColumn fx:id="colDate" text="Reported Time" prefWidth="180"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- DETAILS & ACTION SECTION -->
            <HBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Driver's Full Description:" style="-fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                    <TextArea fx:id="descTextArea" editable="false" wrapText="true" prefHeight="80"
                              style="-fx-background-radius: 6; -fx-control-inner-background: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                </VBox>

                <VBox spacing="10" alignment="CENTER_LEFT" prefWidth="180">
                    <Button fx:id="btnViewPhoto" text="📸 View Photo Proof" onAction="#handleViewPhoto" disable="true" prefWidth="170" prefHeight="35"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Button fx:id="btnResolve" text="✅ Mark as Resolved" onAction="#handleResolveIncident" disable="true" prefWidth="170" prefHeight="35"
                            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>