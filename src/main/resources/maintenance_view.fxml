<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fleetmanagement.controllers.MaintenanceController"
            stylesheets="@style.css"
            style="-fx-background-color: #f1f5f9;">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" prefWidth="220" style="-fx-background-color: #0f172a;" spacing="2">
            <padding><Insets top="25" right="0" bottom="25" left="0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox.margin><Insets left="15" right="10" bottom="30"/></VBox.margin>
                <StackPane prefWidth="36" prefHeight="36" style="-fx-background-color: #2563eb; -fx-background-radius: 8;">
                    <Label text="🚛" style="-fx-font-size: 18px;"/>
                </StackPane>
                <VBox spacing="0">
                    <Label text="𝙁𝙇𝙀𝙀𝙏" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="𝙈𝘼𝙉𝘼𝙂𝙀𝙈𝙀𝙉𝙏" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 10px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="☰" onAction="#toggleSidebar" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 18px; -fx-cursor: hand; -fx-padding: 0;"/>
            </HBox>

            <Label text="  📊    Dashboard" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToDashboard"/>
            <Label text="  🚛    Vehicles" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToVehicles"/>
            <Label text="  👨‍✈️    Drivers" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToDrivers"/>
            <Label text="  🎁    Receivers" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToReceivers"/>
            <Label text="  🛣️    Trips" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToTrips"/>
            <Label text="  🔧    Maintenance" textFill="WHITE" prefWidth="220" prefHeight="45" style="-fx-background-color: #2563eb; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToMaintenance"/>
            <Label text="  🚨    Incidents" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToIncidents"/>
            <Label text="  📈    Reports" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToReports"/>
            <Label text="  📥    Order Requests" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToOrderRequests"/>
            <Label text="  📦    Order Proof" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToOrderProof"/>
            <Label text="  ⚙️    Settings" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToSettings"/>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <!-- HEADER & HAMBURGER -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button fx:id="btnHamburger" text="☰" onAction="#toggleSidebar" visible="false" managed="false"
                        prefHeight="35" prefWidth="40"
                        style="-fx-background-color: #e2e8f0; -fx-text-fill: #0f172a; -fx-background-radius: 6; -fx-font-size: 18px; -fx-cursor: hand;"/>
                <Label text="Maintenance Management" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            </HBox>

            <!-- FORM CONTAINER -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                <padding>
                    <Insets top="18" right="22" bottom="18" left="22"/>
                </padding>

                <GridPane hgap="20" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130"/>
                        <ColumnConstraints minWidth="220"/>
                        <ColumnConstraints minWidth="130"/>
                        <ColumnConstraints minWidth="220"/>
                    </columnConstraints>

                    <Label text="Maintenance ID" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="maintenanceIdField" promptText="Auto-generated" editable="false" style="-fx-background-radius: 6; -fx-background-color: #f8fafc;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Vehicle ID" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="3">
                        <TextField fx:id="vehicleIdField" promptText="e.g. V001" prefWidth="130" style="-fx-background-radius: 6;"/>
                        <Button text="🔍 View" onAction="#showAvailableVehiclesPopup" prefWidth="75"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>

                    <Label text="Maintenance Date" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="maintenanceDatePicker" promptText="Select date" prefWidth="220" style="-fx-background-radius: 6;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Maintenance Type" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <ComboBox fx:id="maintenanceTypeComboBox" prefWidth="220" style="-fx-background-radius: 6;" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                    <Label text="Cost (₹)" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="costField" promptText="e.g. 2500" style="-fx-background-radius: 6;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Next Service Date" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                    <DatePicker fx:id="nextServiceDatePicker" promptText="Select next date" prefWidth="220" style="-fx-background-radius: 6;" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                    <Label text="Status" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="statusComboBox" prefWidth="220" style="-fx-background-radius: 6;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Description" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                    <TextField fx:id="descriptionField" promptText="e.g. Oil change and brake inspect" style="-fx-background-radius: 6;" GridPane.rowIndex="3" GridPane.columnIndex="3"/>
                </GridPane>

                <!-- ACTION BUTTONS -->
                <HBox spacing="10">
                    <VBox.margin><Insets top="8"/></VBox.margin>

                    <Button fx:id="btnAddMaintenance" text="Add Maintenance" prefWidth="135" prefHeight="33"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleAddMaintenance"/>

                    <Button fx:id="btnUpdate" text="Update" prefWidth="85" prefHeight="33"
                            style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleUpdateMaintenance"/>

                    <Button fx:id="btnDelete" text="Delete" prefWidth="85" prefHeight="33"
                            style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleDeleteMaintenance"/>

                    <Button fx:id="btnClear" text="Clear" prefWidth="85" prefHeight="33"
                            style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleClearForm"/>

                    <Button fx:id="btnClearAll" text="Clear All" prefWidth="95" prefHeight="33"
                            style="-fx-background-color: #7c2d12; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleClearAllRecords"/>
                </HBox>
            </VBox>

            <!-- SEARCH FILTER SECTION -->
            <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <Label text="Maintenance Records" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Filter:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="filterCategory1ComboBox" prefWidth="130" style="-fx-background-radius: 6;"/>
                    <ComboBox fx:id="filterCategory2ComboBox" prefWidth="130" style="-fx-background-radius: 6;"/>
                    <TextField fx:id="searchField" promptText="Search keyword..." prefWidth="220"
                               style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1;"/>

                    <Button fx:id="btnSearch" text="🔍 Search" prefWidth="90" prefHeight="30"
                            style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleSearchMaintenance"/>

                    <Button fx:id="btnReset" text="Reset" prefWidth="75" prefHeight="30"
                            style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleResetSearch"/>
                </HBox>
            </VBox>

            <!-- TABLE VIEW -->
            <TableView fx:id="maintenanceTable" prefHeight="230" VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="75"/>
                    <TableColumn fx:id="colVehicle" text="Vehicle" prefWidth="85"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="105"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="105"/>
                    <TableColumn fx:id="colCost" text="Cost (₹)" prefWidth="95"/>
                    <TableColumn fx:id="colNextService" text="Next Service" prefWidth="105"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="105"/>
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="240"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>