<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fleetmanagement.controllers.OrderProofController"
            stylesheets="@style.css"
            style="-fx-background-color: #f1f5f9;">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" prefWidth="220" style="-fx-background-color: #0f172a;" spacing="2">
            <padding><Insets top="25" right="0" bottom="25" left="0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox.margin><Insets left="15" right="10" bottom="30"/></VBox.margin>
                <StackPane prefWidth="36" prefHeight="36" style="-fx-background-color: #2563eb; -fx-background-radius: 8;">
                    <Label text="🚛" style="-fx-font-size: 18px;"/>
                </StackPane>
                <VBox spacing="0">
                    <Label text="𝙁𝙇𝙀𝙀𝙏" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="𝙈𝘼𝙉𝘼𝙂𝙀𝙈𝙀𝙉𝙏" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 10px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="☰" onAction="#toggleSidebar" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 18px; -fx-cursor: hand; -fx-padding: 0;"/>
            </HBox>

            <Label text="  📊    Dashboard" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToDashboard"/>
            <Label text="  🚛    Vehicles" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToVehicles"/>
            <Label text="  👨‍✈️    Drivers" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToDrivers"/>
            <Label text="  🎁    Receivers" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToReceivers"/>
            <Label text="  🛣️    Trips" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToTrips"/>
            <Label text="  🔧    Maintenance" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToMaintenance"/>
            <Label text="  🚨    Incidents" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToIncidents"/>
            <Label text="  📈    Reports" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToReports"/>
            <Label text="  📥    Order Requests" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToOrderRequests"/>
            <Label text="  📦    Order Proof" textFill="WHITE" prefWidth="220" prefHeight="45" style="-fx-background-color: #2563eb; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToOrderProof"/>
            <Label text="  ⚙️    Settings" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToSettings"/>
        </VBox>
    </left>

    <!-- CENTER CONTENT (scrollable so everything fits on small windows) -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #f1f5f9; -fx-background-color: #f1f5f9;">
            <VBox spacing="15">
                <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>

                <!-- HEADER + ACTION BUTTONS -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button fx:id="btnHamburger" text="☰" onAction="#toggleSidebar" visible="false" managed="false"
                            prefHeight="35" prefWidth="40"
                            style="-fx-background-color: #e2e8f0; -fx-text-fill: #0f172a; -fx-background-radius: 6; -fx-font-size: 18px; -fx-cursor: hand;"/>
                    <Label text="Order Proof Verification" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🔄 Refresh" onAction="#handleRefresh" prefHeight="33"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button text="Delete" onAction="#handleDeleteSelected" prefWidth="85" prefHeight="33"
                            style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button text="Delete All" onAction="#handleDeleteAll" prefWidth="95" prefHeight="33"
                            style="-fx-background-color: #7c2d12; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>

                <!-- SEARCH / FILTER -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Filter By:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="filterCategoryComboBox" prefWidth="130" style="-fx-background-radius: 6;"/>
                    <TextField fx:id="searchField" promptText="Enter keyword..." prefWidth="180"
                               style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1;"/>
                    <ComboBox fx:id="statusFilterComboBox" prefWidth="130" style="-fx-background-radius: 6;"/>
                    <Button fx:id="btnSearch" text="🔍 Search" prefWidth="90" prefHeight="30" onAction="#handleSearch"
                            style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button text="Reset" prefWidth="75" prefHeight="30" onAction="#handleReset"
                            style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>

                <!-- TABLE -->
                <TableView fx:id="proofTable" prefHeight="210"
                           style="-fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colReportId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colTrip" text="Trip" prefWidth="70"/>
                        <TableColumn fx:id="colDriver" text="Driver" prefWidth="120"/>
                        <TableColumn fx:id="colReceiver" text="Receiver" prefWidth="85"/>
                        <TableColumn fx:id="colDriverStatus" text="Driver Status" prefWidth="120"/>
                        <TableColumn fx:id="colReceiverStatus" text="Receiver Status" prefWidth="120"/>
                        <TableColumn fx:id="colMatch" text="Match" prefWidth="110"/>
                        <TableColumn fx:id="colAdminStatus" text="Admin Decision" prefWidth="115"/>
                    </columns>
                </TableView>

                <!-- SELECTED TRIP BANNER -->
                <VBox spacing="6" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16 12 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <Label fx:id="lblTripRoute" text="Select a record from the table to review" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label fx:id="lblMatchBanner" text="" maxWidth="Infinity"/>
                </VBox>

                <!-- SIDE-BY-SIDE COMPARISON -->
                <SplitPane dividerPositions="0.5" prefHeight="430" style="-fx-background-color: transparent;">
                    <!-- DRIVER -->
                    <VBox spacing="10" style="-fx-background-color: white;">
                        <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
                        <Label text="🚚 Driver's Claim" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                        <GridPane hgap="12" vgap="6">
                            <columnConstraints>
                                <ColumnConstraints minWidth="95"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Driver:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="lblDriverName" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Vehicle:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="lblVehicle" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Status:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="lblDriverStatus" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="Quantity:" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <Label fx:id="lblDriverQty" text="-" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            <Label text="Accepted By:" style="-fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <Label fx:id="lblDriverReceiver" text="-" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                            <Label text="Submitted:" style="-fx-font-weight: bold;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                            <Label fx:id="lblDriverTime" text="-" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                            <Label text="Remarks:" style="-fx-font-weight: bold;" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                            <Label fx:id="lblDriverRemarks" text="-" wrapText="true" maxWidth="300" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                        </GridPane>
                        <StackPane prefHeight="190" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-cursor: hand;" onMouseClicked="#openDriverImage">
                            <ImageView fx:id="driverImage" fitWidth="320" fitHeight="180" preserveRatio="true"/>
                            <Label fx:id="lblDriverNoPhoto" text="No photo" style="-fx-text-fill: #94a3b8;"/>
                        </StackPane>
                        <Label text="Click photo to enlarge" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                    </VBox>

                    <!-- RECEIVER -->
                    <VBox spacing="10" style="-fx-background-color: white;">
                        <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
                        <Label text="🎁 Receiver's Confirmation" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ea580c;"/>
                        <GridPane hgap="12" vgap="6">
                            <columnConstraints>
                                <ColumnConstraints minWidth="95"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Receiver ID:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="lblReceiverId" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Accepted By:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="lblReceiverPerson" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Status:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="lblReceiverStatus" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="Quantity:" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <Label fx:id="lblReceiverQty" text="-" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            <Label text="Rating:" style="-fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <Label fx:id="lblReceiverRating" text="-" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                            <Label text="Notes:" style="-fx-font-weight: bold;" GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                            <Label fx:id="lblReceiverNotes" text="-" wrapText="true" maxWidth="300" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        </GridPane>
                        <StackPane prefHeight="190" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-cursor: hand;" onMouseClicked="#openReceiverImage">
                            <ImageView fx:id="receiverImage" fitWidth="320" fitHeight="180" preserveRatio="true"/>
                            <Label fx:id="lblReceiverNoPhoto" text="No photo" style="-fx-text-fill: #94a3b8;"/>
                        </StackPane>
                        <Label text="Click photo to enlarge" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                </SplitPane>

                <!-- ADMIN DECISION -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 14 18 14 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Admin Decision" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblAdminStatus" text=""/>
                    </HBox>
                    <TextArea fx:id="adminRemarksArea" prefRowCount="2" wrapText="true"
                              promptText="Admin remarks (required when flagging a discrepancy)"/>
                    <HBox spacing="10">
                        <Button fx:id="btnApprove" text="✅ Approve Delivery" prefHeight="35" onAction="#handleApprove"
                                style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="btnFlag" text="🚩 Flag Discrepancy" prefHeight="35" onAction="#handleFlag"
                                style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>