<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fleetmanagement.controllers.OrderRequestController"
            stylesheets="@style.css"
            style="-fx-background-color: #f1f5f9;">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" prefWidth="220" style="-fx-background-color: #0f172a;" spacing="2">
            <padding><Insets top="25" right="0" bottom="25" left="0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox.margin><Insets left="15" right="10" bottom="30"/></VBox.margin>
                <StackPane prefWidth="36" prefHeight="36" style="-fx-background-color: #2563eb; -fx-background-radius: 8;">
                    <Label text="🚛" style="-fx-font-size: 18px;"/>
                </StackPane>
                <VBox spacing="0">
                    <Label text="𝙁𝙇𝙀𝙀𝙏" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="𝙈𝘼𝙉𝘼𝙂𝙀𝙈𝙀𝙉𝙏" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 10px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="☰" onAction="#toggleSidebar" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 18px; -fx-cursor: hand; -fx-padding: 0;"/>
            </HBox>

            <Label text="  📊    Dashboard" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToDashboard"/>
            <Label text="  🚛    Vehicles" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToVehicles"/>
            <Label text="  👨‍✈️    Drivers" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToDrivers"/>
            <Label text="  🎁    Receivers" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToReceivers"/>
            <Label text="  🛣️    Trips" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToTrips"/>
            <Label text="  🔧    Maintenance" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToMaintenance"/>
            <Label text="  🚨    Incidents" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToIncidents"/>
            <Label text="  📦    Order Proof" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToOrderProof"/>
            <Label text="  📥    Order Requests" textFill="WHITE" prefWidth="220" prefHeight="45" style="-fx-background-color: #2563eb; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToOrderRequests"/>
            <Label text="  📈    Reports" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToReports"/>
            <Label text="  ⚙️    Settings" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToSettings"/>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #f1f5f9; -fx-background-color: #f1f5f9;">
            <VBox spacing="15">
                <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>

                <!-- HEADER + ACTION BUTTONS -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button fx:id="btnHamburger" text="☰" onAction="#toggleSidebar" visible="false" managed="false"
                            prefHeight="35" prefWidth="40"
                            style="-fx-background-color: #e2e8f0; -fx-text-fill: #0f172a; -fx-background-radius: 6; -fx-font-size: 18px; -fx-cursor: hand;"/>
                    <Label text="New Order Requests" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label fx:id="lblPendingCount" text="" style="-fx-background-color: #fef3c7; -fx-text-fill: #92400e; -fx-font-weight: bold; -fx-padding: 4 10 4 10; -fx-background-radius: 12;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🔄 Refresh" onAction="#handleRefresh" prefHeight="33"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button text="Delete" onAction="#handleDeleteSelected" prefWidth="85" prefHeight="33"
                            style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button text="Delete All" onAction="#handleDeleteAll" prefWidth="95" prefHeight="33"
                            style="-fx-background-color: #7c2d12; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>

                <!-- SEARCH / FILTER -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Filter By:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="filterCategoryComboBox" prefWidth="130" style="-fx-background-radius: 6;"/>
                    <TextField fx:id="searchField" promptText="Enter keyword..." prefWidth="180"
                               style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1;"/>
                    <ComboBox fx:id="statusFilterComboBox" prefWidth="150" style="-fx-background-radius: 6;"/>
                    <Button text="🔍 Search" prefWidth="90" prefHeight="30" onAction="#handleSearch"
                            style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button text="Reset" prefWidth="75" prefHeight="30" onAction="#handleReset"
                            style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>

                <!-- TABLE -->
                <TableView fx:id="requestTable" prefHeight="230"
                           style="-fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colRequestId" text="ID" prefWidth="45"/>
                        <TableColumn fx:id="colReceiver" text="Receiver" prefWidth="75"/>
                        <TableColumn fx:id="colCompany" text="Company" prefWidth="120"/>
                        <TableColumn fx:id="colPickup" text="Pickup" prefWidth="130"/>
                        <TableColumn fx:id="colDelivery" text="Delivery" prefWidth="130"/>
                        <TableColumn fx:id="colPickupDate" text="Pickup Date" prefWidth="95"/>
                        <TableColumn fx:id="colCargo" text="Cargo" prefWidth="90"/>
                        <TableColumn fx:id="colWeight" text="Weight (kg)" prefWidth="85"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="115"/>
                    </columns>
                </TableView>

                <!-- REQUEST DETAILS -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 14 18 14 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <Label text="📥 Request Details" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                    <GridPane hgap="14" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="110"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="38"/>
                            <ColumnConstraints minWidth="110"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="38"/>
                        </columnConstraints>

                        <Label text="Request ID:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblReqId" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Requested At:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label fx:id="lblRequestedAt" text="-" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                        <Label text="Receiver:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lblReceiver" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Company:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <Label fx:id="lblCompany" text="-" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                        <Label text="Phone:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="lblPhone" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Status:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                        <Label fx:id="lblStatus" text="-" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                        <Label text="Pickup:" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                        <Label fx:id="lblPickup" text="-" wrapText="true" maxWidth="300" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="Delivery:" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="2" GridPane.valignment="TOP"/>
                        <Label fx:id="lblDelivery" text="-" wrapText="true" maxWidth="300" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

                        <Label text="Pickup Date:" style="-fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Label fx:id="lblPickupDate" text="-" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        <Label text="Cargo Type:" style="-fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
                        <Label fx:id="lblCargo" text="-" GridPane.rowIndex="4" GridPane.columnIndex="3"/>

                        <Label text="Weight:" style="-fx-font-weight: bold;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <Label fx:id="lblWeight" text="-" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        <Label text="Reviewed At:" style="-fx-font-weight: bold;" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
                        <Label fx:id="lblReviewedAt" text="-" GridPane.rowIndex="5" GridPane.columnIndex="3"/>

                        <Label text="Customer Notes:" style="-fx-font-weight: bold;" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                        <Label fx:id="lblCustomerNotes" text="-" wrapText="true" maxWidth="600" GridPane.rowIndex="6" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
                    </GridPane>
                </VBox>

                <!-- ADMIN DECISION -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 14 18 14 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                    <Label text="Admin Decision" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                    <TextArea fx:id="adminRemarksArea" prefRowCount="2" wrapText="true"
                              promptText="Admin remarks (required when rejecting a request)"/>
                    <HBox spacing="10">
                        <Button text="✅ Approve Request" prefHeight="35" onAction="#handleApprove"
                                style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button text="❌ Reject Request" prefHeight="35" onAction="#handleReject"
                                style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>