<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fleetmanagement.controllers.ReportController"
            stylesheets="@style.css"
            style="-fx-background-color: #f1f5f9;">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" prefWidth="220" style="-fx-background-color: #0f172a;" spacing="2">
            <padding><Insets top="25" right="0" bottom="25" left="0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox.margin><Insets left="15" right="10" bottom="30"/></VBox.margin>
                <StackPane prefWidth="36" prefHeight="36" style="-fx-background-color: #2563eb; -fx-background-radius: 8;">
                    <Label text="🚛" style="-fx-font-size: 18px;"/>
                </StackPane>
                <VBox spacing="0">
                    <Label text="𝙁𝙇𝙀𝙀𝙏" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="𝙈𝘼𝙉𝘼𝙂𝙀𝙈𝙀𝙉𝙏" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 10px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="☰" onAction="#toggleSidebar" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 18px; -fx-cursor: hand; -fx-padding: 0;"/>
            </HBox>

            <Label text="  📊    Dashboard" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToDashboard"/>
            <Label text="  🚛    Vehicles" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToVehicles"/>
            <Label text="  👨‍✈️    Drivers" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToDrivers"/>
            <Label text="  🛣️    Trips" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToTrips"/>
            <Label text="  🔧    Maintenance" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToMaintenance"/>
            <Label text="  🚨    Incidents" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToIncidents"/>
            <Label text="  📈    Reports" textFill="WHITE" prefWidth="220" prefHeight="45" style="-fx-background-color: #2563eb; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToReports"/>
            <Label text="  ⚙️    Settings" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToSettings"/>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <!-- HEADER & HAMBURGER -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button fx:id="btnHamburger" text="☰" onAction="#toggleSidebar" visible="false" managed="false"
                        prefHeight="35" prefWidth="40"
                        style="-fx-background-color: #e2e8f0; -fx-text-fill: #0f172a; -fx-background-radius: 6; -fx-font-size: 18px; -fx-cursor: hand;"/>
                <Label text="Reports &amp; Analytics Center" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            </HBox>

            <!-- FILTER CONTROLS CONTAINER -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                <padding>
                    <Insets top="18" right="22" bottom="18" left="22"/>
                </padding>

                <GridPane hgap="20" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="110"/>
                        <ColumnConstraints minWidth="220"/>
                        <ColumnConstraints minWidth="110"/>
                        <ColumnConstraints minWidth="220"/>
                    </columnConstraints>

                    <Label text="Report Type" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="reportTypeComboBox" prefWidth="220" style="-fx-background-radius: 6;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Vehicle Filter" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <ComboBox fx:id="vehicleFilterComboBox" prefWidth="220" style="-fx-background-radius: 6;" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    <Label text="From Date" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="fromDatePicker" promptText="Select start date" prefWidth="220" style="-fx-background-radius: 6;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="To Date" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <DatePicker fx:id="toDatePicker" promptText="Select end date" prefWidth="220" style="-fx-background-radius: 6;" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                    <Label text="Status Filter" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="statusFilterComboBox" prefWidth="220" style="-fx-background-radius: 6;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>

                <!-- ACTION BUTTONS -->
                <HBox spacing="10">
                    <VBox.margin><Insets top="8"/></VBox.margin>

                    <Button fx:id="btnGenerateReport" text="Generate Report" prefWidth="135" prefHeight="33"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleGenerateReport"/>

                    <Button fx:id="btnClearFilters" text="Clear Filters" prefWidth="105" prefHeight="33"
                            style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleClearFilters"/>

                    <Button fx:id="btnDownloadReport" text="📥 Download Report" prefWidth="140" prefHeight="33"
                            style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleDownloadReport"/>
                </HBox>
            </VBox>

            <!-- RESULTS SECTION -->
            <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label fx:id="sectionHeaderLabel" text="Trip Report Results" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchField" promptText="Enter keyword to search..." prefWidth="250"
                               style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1;"/>
                </HBox>

                <!-- DYNAMIC TABLE VIEW -->
                <TableView fx:id="reportTable" prefHeight="230" VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 8;">
                    <!-- Columns generated dynamically based on selected report type -->
                </TableView>

                <Label fx:id="totalRecordsLabel" text="Total Records: 0" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>