<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fleetmanagement.controllers.VehicleController"
            stylesheets="@style.css"
            style="-fx-background-color: #f1f5f9;">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" prefWidth="220" style="-fx-background-color: #0f172a;" spacing="2">
            <padding><Insets top="25" right="0" bottom="25" left="0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox.margin><Insets left="15" right="10" bottom="30"/></VBox.margin>
                <StackPane prefWidth="36" prefHeight="36" style="-fx-background-color: #2563eb; -fx-background-radius: 8;">
                    <Label text="🚛" style="-fx-font-size: 18px;"/>
                </StackPane>
                <VBox spacing="0">
                    <Label text="𝙁𝙇𝙀𝙀𝙏" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="𝙈𝘼𝙉𝘼𝙂𝙀𝙈𝙀𝙉𝙏" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 10px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="☰" onAction="#toggleSidebar" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 18px; -fx-cursor: hand; -fx-padding: 0;"/>
            </HBox>

            <Label text="  📊    Dashboard" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToDashboard"/>
            <Label text="  🚛    Vehicles" textFill="WHITE" prefWidth="220" prefHeight="45" style="-fx-background-color: #2563eb; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToVehicles"/>
            <Label text="  👨‍✈️    Drivers" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToDrivers"/>
            <Label text="  🛣️    Trips" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToTrips"/>
            <Label text="  🔧    Maintenance" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToMaintenance"/>
            <Label text="  🚨    Incidents" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToIncidents"/>
            <Label text="  📈    Reports" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToReports"/>
            <Label text="  ⚙️    Settings" textFill="#cbd5e1" prefWidth="220" prefHeight="45" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" onMouseClicked="#switchToSettings"/>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <!-- HEADER & HAMBURGER -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button fx:id="btnHamburger" text="☰" onAction="#toggleSidebar" visible="false" managed="false"
                        prefHeight="35" prefWidth="40"
                        style="-fx-background-color: #e2e8f0; -fx-text-fill: #0f172a; -fx-background-radius: 6; -fx-font-size: 18px; -fx-cursor: hand;"/>
                <Label text="Vehicle Management" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            </HBox>

            <!-- FORM CONTAINER -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                <padding>
                    <Insets top="18" right="22" bottom="18" left="22"/>
                </padding>

                <GridPane hgap="20" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="110"/>
                        <ColumnConstraints minWidth="220"/>
                        <ColumnConstraints minWidth="110"/>
                        <ColumnConstraints minWidth="220"/>
                    </columnConstraints>

                    <Label text="Vehicle ID" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="vehicleIdField" promptText="e.g. V001" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Registration No" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <TextField fx:id="regNoField" promptText="e.g. TN01AB1234" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1;" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    <Label text="Vehicle Type" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="vehicleTypeComboBox" prefWidth="220" style="-fx-background-radius: 6;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Model" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <TextField fx:id="modelField" promptText="e.g. Tata Ace" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1;" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                    <Label text="Capacity (kg)" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="capacityField" promptText="e.g. 1500" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Fuel Type" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                    <ComboBox fx:id="fuelTypeComboBox" prefWidth="220" style="-fx-background-radius: 6;" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                    <Label text="Status" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="statusComboBox" prefWidth="220" style="-fx-background-radius: 6;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>

                <!-- ACTION BUTTONS -->
                <HBox spacing="10">
                    <VBox.margin><Insets top="8"/></VBox.margin>

                    <Button fx:id="btnAdd" text="Add" prefWidth="85" prefHeight="33"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleAddVehicle"/>

                    <Button fx:id="btnUpdate" text="Update" prefWidth="85" prefHeight="33"
                            style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleUpdateVehicle"/>

                    <Button fx:id="btnDelete" text="Delete" prefWidth="85" prefHeight="33"
                            style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleDeleteVehicle"/>

                    <Button fx:id="btnClear" text="Clear" prefWidth="85" prefHeight="33"
                            style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleClearForm"/>

                    <Button fx:id="btnClearAll" text="Clear All" prefWidth="95" prefHeight="33"
                            style="-fx-background-color: #7c2d12; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                            onAction="#handleClearAllRecords"/>
                </HBox>
            </VBox>

            <!-- SEARCH FILTER SECTION -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Filter By:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="filterCategoryComboBox" prefWidth="150" style="-fx-background-radius: 6;"/>
                <TextField fx:id="searchField" promptText="Enter keyword to search..." prefWidth="250"
                           style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1;"/>

                <Button fx:id="btnSearch" text="🔍 Search" prefWidth="90" prefHeight="30"
                        style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                        onAction="#handleSearchVehicle"/>

                <Button text="Reset" prefWidth="75" prefHeight="30"
                        style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"
                        onAction="#handleResetSearchAction"/>
            </HBox>

            <!-- TABLE VIEW -->
            <TableView fx:id="vehicleTable" prefHeight="260" VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <columns>
                    <TableColumn fx:id="colVehicleId" text="Vehicle ID" prefWidth="110"/>
                    <TableColumn fx:id="colRegNo" text="Registration No" prefWidth="140"/>
                    <TableColumn fx:id="colVehicleType" text="Vehicle Type" prefWidth="110"/>
                    <TableColumn fx:id="colModel" text="Model" prefWidth="130"/>
                    <TableColumn fx:id="colCapacity" text="Capacity (kg)" prefWidth="110"/>
                    <TableColumn fx:id="colFuelType" text="Fuel Type" prefWidth="110"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>